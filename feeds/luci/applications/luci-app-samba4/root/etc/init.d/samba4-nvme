#!/bin/sh /etc/rc.common

START=98
USE_PROCD=1

start_service() {
	# procd owns one worker; disk I/O must not block boot or the hotplug queue.
	procd_open_instance
	procd_set_param command /usr/libexec/samba4-nvme reconcile
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
