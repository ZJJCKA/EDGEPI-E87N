#!/bin/sh
set -eu

user=${1-}
password=${2-}

case "$user" in
	''|*[!A-Za-z0-9_.-]*)
		echo 'Invalid Samba account name' >&2
		exit 2
		;;
esac

[ ${#password} -ge 4 ] || {
	echo 'Samba password must contain at least 4 characters' >&2
	exit 2
}

grep -q "^${user}:" /etc/passwd || {
	echo "Local account does not exist: $user" >&2
	exit 3
}

printf '%s\n%s\n' "$password" "$password" | /usr/bin/smbpasswd -s -a "$user"

# The stock template rejects root globally. Allow it only when LuCI explicitly
# provisions an authenticated root share with a Samba password.
if [ "$user" = root ]; then
	for config in /etc/samba/smb.conf.template /var/etc/smb.conf; do
		[ -f "$config" ] || continue
		sed -i -e '/^[[:space:]]*invalid users[[:space:]]*=[[:space:]]*root[[:space:]]*$/s/^/# LuCI authenticated root: /' "$config"
	done
	/etc/init.d/samba4 reload >/dev/null 2>&1 || true
fi
