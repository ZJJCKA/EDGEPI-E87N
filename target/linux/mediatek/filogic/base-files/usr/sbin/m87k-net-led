#!/bin/sh

# M87K eth1 uses two active-low GPIO LEDs rather than PHY LED outputs.
# Preserve the agreed speed meaning while blinking only the selected colour:
# 100 Mbit/s = yellow, 1 Gbit/s = green, 2.5 Gbit/s = green + yellow.

netdev=eth1
green=/sys/class/leds/LED-WAN-G
yellow=/sys/class/leds/LED-WAN-Y

[ -d "$green" ] && [ -d "$yellow" ] || exit 0

set_led() {
	echo "$2" > "$1/brightness"
}

disable_triggers() {
	echo none > "$green/trigger"
	echo none > "$yellow/trigger"
}

# This BusyBox build accepts fractional timeouts but not fractional sleep
# arguments. Use timeout as a quiet millisecond delay primitive.
delay() {
	timeout "$1" sleep 1 2>/dev/null || :
}

read_counter() {
	local rx tx
	read -r rx < "/sys/class/net/$netdev/statistics/rx_packets" || rx=0
	read -r tx < "/sys/class/net/$netdev/statistics/tx_packets" || tx=0
	echo $((rx + tx))
}

disable_triggers
last_packets="$(read_counter)"
last_speed=0

while :; do
	carrier=0
	[ -r "/sys/class/net/$netdev/carrier" ] && read -r carrier < "/sys/class/net/$netdev/carrier"

	if [ "$carrier" != 1 ]; then
		[ "$last_speed" = 0 ] || {
			set_led "$green" 0
			set_led "$yellow" 0
			last_speed=0
		}
		last_packets="$(read_counter)"
		delay 0.1
		continue
	fi

	read -r speed < "/sys/class/net/$netdev/speed" || speed=0
	case "$speed" in
		10|100) green_on=0; yellow_on=1 ;;
		1000)   green_on=1; yellow_on=0 ;;
		2500)   green_on=1; yellow_on=1 ;;
		*)      green_on=0; yellow_on=0 ;;
	esac

	packets="$(read_counter)"
	packet_delta=$((packets - last_packets))
	# Ignore isolated broadcast and keepalive packets.  Without this threshold,
	# normal idle-WAN chatter makes the GPIO LEDs appear to flicker constantly.
	# Sustained user traffic still exceeds four packets per 32 ms sample and
	# retains the agreed activity cadence.
	if [ "$packet_delta" -ge 4 ]; then
		set_led "$green" 0
		set_led "$yellow" 0
		delay 0.032
	fi

	set_led "$green" "$green_on"
	set_led "$yellow" "$yellow_on"
	last_packets="$packets"
	last_speed="$speed"
	# Visually match the RTL8221 activity cadence: 32 ms, 50% duty.
	delay 0.032
done
