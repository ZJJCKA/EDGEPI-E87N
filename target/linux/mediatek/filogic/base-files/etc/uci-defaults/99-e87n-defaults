. /lib/functions.sh

case "$(board_name)" in
	edgepi,e87n|mangopi,m87k)
		# Requested factory login for fresh images: root / password.
		printf '%s\n%s\n' 'password' 'password' | passwd root >/dev/null 2>&1
		case "$(board_name)" in
			edgepi,e87n)
				uci -q set system.@system[0].hostname='EdgePi E87N'
				;;
			mangopi,m87k)
				uci -q set system.@system[0].hostname='MangoPi M87K'
				;;
		esac
		uci -q set system.@system[0].zonename='Asia/Shanghai'
		uci -q set system.@system[0].timezone='CST-8'
		uci -q delete system.ntp.server
		uci -q add_list system.ntp.server='ntp1.aliyun.com'
		uci -q add_list system.ntp.server='ntp2.aliyun.com'
		uci -q add_list system.ntp.server='ntp3.aliyun.com'
		uci -q commit system
		# Keep the legacy LuCI representation: address and netmask are separate.
		# netifd derives the same /24 at runtime without displaying it in ipaddr.
		uci -q set network.lan.ipaddr='192.168.8.1'
		uci -q set network.lan.netmask='255.255.255.0'
		uci -q delete network.lan.dns
		uci -q add_list network.lan.dns='223.5.5.5'
		uci -q add_list network.lan.dns='223.6.6.6'
		uci -q commit network

		# Allocate the 192.168.8.2-254 pool from the lowest free address.
		uci -q set 'dhcp.@dnsmasq[0].sequential_ip=1'
		uci -q set 'dhcp.lan.ignore=0'
		uci -q set 'dhcp.lan.dhcpv4=server'
		uci -q set 'dhcp.lan.start=2'
		uci -q set 'dhcp.lan.limit=253'
		# With no WAN default route, explicitly advertise no IPv6 default
		# route instead of letting odhcpd warn during every LAN-only boot.
		uci -q set 'dhcp.lan.ra_lifetime=0'
		# Keep AliDNS as the router fallback in WAN, 5G and LAN-only modes.
		uci -q set 'dhcp.@dnsmasq[0].noresolv=1'
		uci -q delete 'dhcp.@dnsmasq[0].server'
		uci -q add_list 'dhcp.@dnsmasq[0].server=223.5.5.5'
		uci -q add_list 'dhcp.@dnsmasq[0].server=223.6.6.6'
		uci -q commit dhcp

		# Retain block info and root-filesystem tools, but let Samba4 exclusively
		# own data-disk mounting on these boards. Never enable a second automounter.
		if ! uci -q get 'fstab.@global[0]' >/dev/null; then
			uci -q add fstab global >/dev/null
		fi
		uci -q set 'fstab.@global[0].anon_swap=0'
		uci -q set 'fstab.@global[0].anon_mount=0'
		uci -q set 'fstab.@global[0].auto_swap=0'
		uci -q set 'fstab.@global[0].auto_mount=0'
		uci -q set 'fstab.@global[0].delay_root=5'
		uci -q set 'fstab.@global[0].check_fs=0'
		uci -q commit fstab
		/etc/init.d/fstab disable >/dev/null 2>&1 || true

		uci -q set 'luci.themes.Argon=/luci-static/argon'
		uci -q set 'luci.main.mediaurlbase=/luci-static/argon'
		# LuCI exposes Simplified Chinese through the zh_cn UCI key.
		uci -q set 'luci.main.lang=zh_cn'
		uci -q delete luci.themes.Bootstrap
		uci -q commit luci

		uci -q set 'argon.@global[0].online_wallpaper=bing'
		uci -q set 'argon.@global[0].mode=normal'
		uci -q set 'argon.@global[0].primary=#5e72e4'
		uci -q set 'argon.@global[0].transparency=0'
		uci -q set 'argon.@global[0].blur=0'
		uci -q set 'argon.@global[0].dark_primary=#483d8b'
		uci -q set 'argon.@global[0].transparency_dark=0'
		uci -q set 'argon.@global[0].blur_dark=0'
		uci -q commit argon

		uci -q set firewall.@defaults[0].flow_offloading='1'
		uci -q set firewall.@defaults[0].flow_offloading_hw='1'
		uci -q commit firewall

		# E87N is commonly used behind a 5G modem whose uplink address is
		# private. Enable the complete UPnP/PCP service set on fresh installs
		# and allow that valid CPE topology without weakening the port ACLs.
		uci -q set 'upnpd.config.enabled=1'
		uci -q set 'upnpd.config.enable_upnp=1'
		uci -q set 'upnpd.config.enable_natpmp=1'
		uci -q set 'upnpd.config.ext_allow_private_ipv4=1'
		uci -q commit upnpd
		/etc/init.d/miniupnpd enable >/dev/null 2>&1 || true

		uci -q set openclash.config.core_version='arm64'
		uci -q commit openclash
		;;
esac

exit 0
